#!/bin/sh
# NOTHING RED REACHES MAIN. Added 2026-08-23.
#
# main auto-deploys to hoodii.studio, and on 2026-08-22 two Claude sessions were pushing to it in
# the same hour. One pushed a recipe whose text contained an en dash, lint-prose refused it, and the
# Vercel deploy failed. Silvio saw it before either session did: "theres another agent working and
# you two keep clasinh and the dlopyment failed."
#
# scripts/verify.mjs already existed for exactly this, and its own header says it is "the thing a
# person or an agent types before pushing". Nothing made anyone type it. A rule that does not
# execute is decoration, and that one was decoration written INSIDE the file that solves the
# problem. This is the part that executes.
#
# 49 seconds on this machine: install --frozen-lockfile, typecheck, lint, build. It prints one line
# that says GREEN or RED and names the gate that failed, and its exit code agrees with the line.
#
# A failing push is not a bug in the hook. It means the tree you are pushing does not build, and
# pushing it would take the live site's next deploy down for whoever else is working today.
#
# --no-verify skips this. If you are reaching for it, the honest move is to say out loud what you
# are skipping and why, because the next deploy after yours inherits it.

# IS HE IN THE GYM RIGHT NOW. Added 2026-08-27.
#
# "He trains off this app. Do not deploy while he is mid-session" was the first warning in the
# 2026-08-27 handoff and it was prose: verify.mjs is offline by design, so nothing executed it.
# This asks gym_session for a row with no finished_at. It runs FIRST because it is one query and
# the gate chain below is 49 seconds, and there is no point building a tree you must not push.
#
# It exits 0 and says so when there is no database URL on this machine, which is the same posture
# check-ladder.mjs takes. GYM_GUARD_OFF=1 overrides it for an abandoned session.
echo "pre-push: checking whether a workout is open right now"
node scripts/guard-live-session.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

echo "pre-push: running the full gate chain before this reaches main and deploys"
node scripts/verify.mjs
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "pre-push: REFUSED. The tree you are pushing does not pass its own gates, and main deploys"
  echo "pre-push: straight to hoodii.studio. Fix the gate named above, or rebase onto whatever the"
  echo "pre-push: other session just pushed if the failure is not yours: git pull --rebase origin main"
  exit 1
fi

exit 0
