  "_substitutes": {
    "_": "requiredItem -> {have: an itemId he owns, note: what to do and the honest cost}. Reported as HAVE VIA, never as a plain have, because it is a different product doing the same job.",
    "stock": {
      "have": "stockcube",
      "note": "One Knorr cube per 2 cups of water, per the box. For cooking purposes this IS stock. It is saltier than fresh and has no body from bones, so go easy on other salt in the dish."
    },
    "tinned tomatoes": {
      "have": "tomatoes_grape",
      "note": "680 g of fresh grape tomatoes, bought 08-12 on clearance. Halve them and cook them down about 10 minutes longer than a tin needs, since they carry more water and no acid correction. Brighter and less deep than tinned."
    },
    "sesame seeds": {
      "have": "sesameoil",
      "note": "No seeds, but the toasted sesame oil carries the same flavour. A few drops at the end instead of a sprinkle. You lose the crunch, which is most of the point of a garnish, so this is a poor swap for texture and a fine one for taste."
    },
    "brown sugar": {
      "have": "sugar",
      "note": "White sugar works. Brown is white sugar plus molasses, so you lose a little caramel depth and the dish is very slightly less moist. In a marinade or a sauce nobody would notice. In a bake it matters more."
    },
    "self raising flour": {
      "have": "flour",
      "note": "Plain flour plus baking powder: 2 tsp of baking powder per 150 g of flour, whisked in dry. You have both."
    },
    "cumin seeds": {
      "have": "cumin",
      "note": "You have ground cumin, not seeds. Use about two thirds as much, and add it later than the recipe says: ground spice burns in seconds where seeds want a minute in hot oil. You lose the pop of a whole seed."
    }
  }
}
