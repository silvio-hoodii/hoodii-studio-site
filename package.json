{
  "name": "hoodii-studio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "validate:recipes": "node content/kitchen/validate.mjs",
    "lint:aliases": "node content/kitchen/lint-aliases.mjs",
    "lint:prose": "node scripts/lint-prose.mjs",
    "validate:gym": "node content/gym/validate.mjs",
    "validate:swim": "node content/swim/validate.mjs",
    "lint:auth": "node scripts/lint-auth.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "build": "node scripts/gen-tokens.mjs --check && node scripts/gen-site-facts.mjs --check && node scripts/lint-prose.mjs && node scripts/lint-classnames.mjs && node scripts/lint-auth.mjs && node scripts/lint-tokens.mjs && node content/kitchen/lint-aliases.mjs && node content/kitchen/validate.mjs --strict && node content/gym/validate.mjs && node content/swim/validate.mjs && node content/reading/validate.mjs && node scripts/lint-probe-routes.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "lint:classnames": "node scripts/lint-classnames.mjs",
    "lint:proberoutes": "node scripts/lint-probe-routes.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:facts": "node scripts/gen-site-facts.mjs",
    "test": "node scripts/verify.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "^2.1.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
